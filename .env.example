# ─────────────────────────────────────────────────────────────
# ABHA Global Educare — Environment Variables
# Copy this file to ".env.local" for local dev, and add the same
# keys in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values (.env.local is gitignored).
# ─────────────────────────────────────────────────────────────

# Contact form email (nodemailer). If SMTP_USER and SMTP_PASSWORD are
# NOT set, the form still "succeeds" but only logs the enquiry — no email
# is actually sent. Set at least SMTP_USER + SMTP_PASSWORD to send mail.

# SMTP server host (Gmail shown; use your provider's host otherwise)
SMTP_HOST=smtp.gmail.com

# SMTP port — 587 for STARTTLS (the code uses secure:false / STARTTLS)
SMTP_PORT=587

# The mailbox that logs in and sends mail (REQUIRED to send)
SMTP_USER=abhaglobaleducare@gmail.com

# App password for that mailbox (REQUIRED to send).
# For Gmail you MUST use a 16-char "App Password" (Google Account →
# Security → 2-Step Verification → App passwords), NOT your normal password.
SMTP_PASSWORD=your-gmail-app-password

# Optional: the "From" header. Defaults to: "ABHA Website" <SMTP_USER>
SMTP_FROM="ABHA Global Educare <abhaglobaleducare@gmail.com>"

# Optional: where new-enquiry notifications are delivered.
# Defaults to abhaglobaleducare@gmail.com if left unset.
SMTP_TO=abhaglobaleducare@gmail.com
